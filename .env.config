# Copy this file to .env and fill in your own values.
OPENAI_API_KEY=your_actual_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL installed locally:
DATABASE_URL=postgresql://postgres:your@localhost:5432/career_assistance

# Optional SQLite fallback: leave DATABASE_URL blank to use this file.
SQLITE_PATH=career_assistance.db
